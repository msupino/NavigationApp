{
  "name": "navaid-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Native iOS and Android shell for NavAid, built with Capacitor around the static docs app.",
  "scripts": {
    "validate": "node scripts/validate-capacitor.mjs",
    "bundle": "node scripts/bundle-web.mjs",
    "bundle:check": "node scripts/bundle-web.mjs --check",
    "embed": "node scripts/bundle-web.mjs --embed && npm run validate && cap sync ios",
    "remote": "node scripts/bundle-web.mjs --remote && npm run sync",
    "copy": "npm run validate && cap copy",
    "sync": "npm run validate && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "npm run sync && cap run android",
    "run:ios": "npm run sync && cap run ios"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "8.4.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "8.4.0",
    "@capacitor/filesystem": "^8.0.1",
    "@capacitor/ios": "8.4.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-social-login": "^8.3.35",
    "@capgo/capacitor-updater": "^8.51.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.0"
  },
  "overrides": {
    "brace-expansion": ">=5.0.9",
    "tar": ">=7.5.21"
  }
}
